#!/bin/bash
# ============================================================
# CloudBase HTTP 云函数（Custom Runtime）增强版启动脚本
# 目标：每一步都有可观测输出；避免静默失败；快速暴露问题
# 约定：CloudBase 代理外部请求到本进程 9000 端口
# ============================================================

# 关键：不要 set -e —— 每步显式检查并输出，避免"悄悄退出"
# 所有输出带 [BOOT] 前缀 + 时间戳，stdout/stderr 均强制实时可见
BOOT_LOG() {
    echo "[BOOT][$(date '+%H:%M:%S')] $*"
}

# zip 不保留执行位：自修复（CloudBase 解压后可能无 +x）
[ -x "$0" ] || chmod +x "$0" 2>/dev/null || true

BOOT_LOG "=== 开始启动 coco-api (scf_bootstrap) ==="
BOOT_LOG "PWD=$(pwd)"
BOOT_LOG "脚本位置=$(dirname "$0")"
BOOT_LOG "PID=$$"

# ── 进入代码目录（CloudBase 解压位置）────────────────────
cd "$(dirname "$0")" 2>/dev/null || cd /var/task 2>/dev/null || cd "$HOME" 2>/dev/null
BOOT_LOG "工作目录: $(pwd)"
BOOT_LOG "目录内容: $(ls -la | head -30 | tr '\n' '|')"

# ── Python 定位 ──────────────────────────────────────────
PYTHON=""
for cand in python3 /usr/bin/python3 /usr/local/bin/python3 /var/lang/bin/python3; do
    if command -v "$cand" >/dev/null 2>&1; then
        PYTHON="$cand"
        break
    fi
done
if [ -z "$PYTHON" ]; then
    BOOT_LOG "FATAL: 未找到 python3！退出码 1"
    exit 1
fi
BOOT_LOG "使用 Python: $PYTHON"
BOOT_LOG "Python 版本: $($PYTHON --version 2>&1)"
BOOT_LOG "pip 版本: $($PYTHON -m pip --version 2>&1 | head -1)"

# ── 环境变量检查（只打 key，不打敏感值）───────────────────
for v in DASHSCOPE_API_KEY WORKSPACE_ID USE_CLOUD_DB CLOUDBASE_DATABASE_URL; do
    if [ -n "${!v:-}" ]; then
        BOOT_LOG "env $v = [已设置]"
    else
        BOOT_LOG "env $v = [未设置!]"
    fi
done

# ── 1. 安装依赖（本地 deps/ 预装 wheel 优先，在线镜像兜底）──
# 关键：容器 site-packages 和 /home/qcloud 均只读，pip 必须 --target 装到 /tmp，
# 并把 /tmp 依赖目录加入 PYTHONPATH（uvicorn 与 app 都能 import 到）。
# 同一实例复用（实例不重启时 /tmp 保留），依赖已装则跳过。
# 预装优化：zip 内 deps/ 含全部 Linux cp311 wheel → --find-links 离线安装（秒级），
# 离线失败再走阿里云在线镜像兜底。
PIP_INDEX="https://mirrors.aliyun.com/pypi/simple/"
PIP_EXTRA="--trusted-host mirrors.aliyun.com --default-timeout=120"
PIP_DEPS="/tmp/coco_deps"
LOCAL_WHEELS="$(pwd)/deps"   # zip 解压后 deps/ 在函数根目录
export PYTHONPATH="$PIP_DEPS:$PYTHONPATH"
mkdir -p "$PIP_DEPS"

install_deps() {
    # $1 = 额外 pip 参数（离线 or 在线）
    timeout 300 "$PYTHON" -m pip install \
        --disable-pip-version-check \
        --no-input \
        --target="$PIP_DEPS" \
        $1 \
        -r requirements.txt > /tmp/pip_install.log 2>&1
    PIP_EXIT=$?
    sed 's/^/[pip] /' /tmp/pip_install.log
    return $PIP_EXIT
}

if [ -f requirements.txt ]; then
    # 已装校验：fastapi + uvicorn + aiomysql 可导入则跳过安装
    if "$PYTHON" -c "import fastapi, uvicorn, aiomysql" 2>/dev/null; then
        BOOT_LOG "[pip] 依赖已安装（实例复用 /tmp 缓存），跳过 pip install"
    else
        # 方案 A：本地 wheel 离线安装（最快，无需联网）
        if [ -d "$LOCAL_WHEELS" ] && ls "$LOCAL_WHEELS"/*.whl >/dev/null 2>&1; then
            BOOT_LOG "[pip] 发现本地预装 wheel（$(ls "$LOCAL_WHEELS"/*.whl | wc -l | tr -d ' ') 个），离线安装..."
            if install_deps "--find-links $LOCAL_WHEELS --no-index"; then
                BOOT_LOG "[pip] 本地离线安装成功 ✅"
            else
                BOOT_LOG "[pip] 本地安装失败（可能缺 wheel），5s 后转在线镜像..."
                sleep 5
                install_deps "-i $PIP_INDEX $PIP_EXTRA"
            fi
        else
            BOOT_LOG "[pip] 无本地 wheel，直接走阿里云在线镜像..."
            install_deps "-i $PIP_INDEX $PIP_EXTRA"
        fi

        # 重试逻辑（若上述一次未成功）
        PIP_OK=0
        for attempt in 1 2 3; do
            if "$PYTHON" -c "import fastapi, uvicorn, aiomysql" 2>/dev/null; then
                PIP_OK=1
                break
            fi
            BOOT_LOG "[pip] 依赖未就绪，第 $attempt 次重试（在线镜像）..."
            install_deps "-i $PIP_INDEX $PIP_EXTRA"
            sleep 5
        done

        if [ "$PIP_OK" -eq 0 ]; then
            BOOT_LOG "FATAL: pip install 3 次均失败，请检查 [pip] 日志"
            exit 1
        fi
        BOOT_LOG "已安装依赖目录: $(ls "$PIP_DEPS" | wc -l) 个包"
    fi
else
    BOOT_LOG "WARN: 未找到 requirements.txt"
fi

# ── 2. 验证核心模块可导入（含真实依赖）───────────────────
BOOT_LOG "验证 app.main 导入..."
"$PYTHON" -c "
import sys
print('[PY] python', sys.version.split()[0])
import fastapi, sqlalchemy, uvicorn
print('[PY] fastapi', fastapi.__version__)
print('[PY] sqlalchemy', sqlalchemy.__version__)
print('[PY] uvicorn', uvicorn.__version__)
import aiomysql; print('[PY] aiomysql OK')
import app.main
print('[PY] app.main import OK')
" 2>&1 | sed 's/^/[IMPORT] /'
IMPORT_EXIT=${PIPESTATUS[0]}
if [ "$IMPORT_EXIT" -ne 0 ]; then
    BOOT_LOG "FATAL: 模块导入失败（退出码 $IMPORT_EXIT）。请检查上方 [IMPORT] 错误。"
    exit 1
fi
BOOT_LOG "模块导入全部成功 ✅"

# ── 3. 启动 uvicorn（前台，输出直通）──────────────────────
BOOT_LOG "启动 uvicorn → 0.0.0.0:9000"
BOOT_LOG "（CloudBase 网关将代理外部请求到此端口）"

exec "$PYTHON" -m uvicorn app.main:app \
    --host 0.0.0.0 \
    --port 9000 \
    --workers 1 \
    --timeout-keep-alive 30 \
    --log-level info \
    --no-access-log
