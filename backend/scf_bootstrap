#!/bin/bash
# CloudBase HTTP 云函数（Custom Runtime / Web 函数）启动脚本
# CloudBase 会调用此脚本启动 HTTP 服务并代理外部请求到 9000 端口

set -e

# CloudBase 把代码解压到 /var/task 或当前目录（不同部署形态）
cd "$(dirname "$0")"

echo "[bootstrap] Working dir: $(pwd)"
echo "[bootstrap] Python: $(python3 --version 2>&1 || /usr/bin/python3 --version 2>&1)"

# 优先用系统 python3（CloudBase 容器内置）
PYTHON=$(command -v python3 || echo /usr/bin/python3)

# 1. 安装依赖（如未装）：CloudBase 也会自动检测 requirements.txt 安装，
#    此处兜底（避免缓存或离线时缺失）
if [ -f requirements.txt ]; then
    echo "[bootstrap] Installing requirements.txt..."
    $PYTHON -m pip install --no-cache-dir -q -r requirements.txt || \
        echo "[bootstrap] pip install failed (will rely on CloudBase auto-install)"
fi

# 2. 验证 app 可导入（提前发现语法/导入错误，避免 9000 端口起不来）
$PYTHON -c "import app.main; print('[bootstrap] app.main OK')" || {
    echo "[bootstrap] Failed to import app.main"
    exit 1
}

# 3. 启动 uvicorn（监听 CloudBase Web 函数默认端口 9000）
#    workers=1 适配 256MB 内存；超时 0 禁用 worker 自杀（lifespan 启动需要时间）
echo "[bootstrap] Starting uvicorn on 0.0.0.0:9000..."
exec $PYTHON -m uvicorn app.main:app \
    --host 0.0.0.0 \
    --port 9000 \
    --workers 1 \
    --timeout-keep-alive 30 \
    --log-level info